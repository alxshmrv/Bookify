# ==========================================
# 1. Настройки Docker Compose
# ==========================================
# Префикс для имен контейнеров (чтобы было красиво)
COMPOSE_PROJECT_NAME=bookify-dev

# ==========================================
# 2. Настройки PostgreSQL (База данных)
# ==========================================
# Учетные данные (Docker передаст их в контейнер базы)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bookify_db
POSTGRES_DATA_PATH=./.containers/database

# ==========================================
# 3. Настройки Keycloak
# ==========================================
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=admin
REALM_EXPORT_FILE=bookify-realm-export.json
AUDIENCE=account
VALID_ISSUER=http://bookify-idp:8080/realms/bookify
METADATA_URL=http://bookify-idp:8080/realms/bookify/.well-known/openid-configuration
HTTPS=false

# ==========================================
# 4. Logging and Observability
# ==========================================
SEQ_FIRSTRUN_ADMINPASSWORD=123


# Окружение (Development включает детальные ошибки)
ASPNETCORE_ENVIRONMENT=Development