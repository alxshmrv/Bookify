{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "https://localhost:5002;http://localhost:5001",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__Database": "Server=localhost;Port=5435;Database=bookify_db;User Id=postgres;Password=postgres;IncludeErrorDetail=true",
        "Authentication__Audience": "account",
        "Authentication__ValidIssuer": "http://bookify-idp:8080/realms/bookify",
        "Authentication__MetadataUrl": "http://bookify-idp:8080/realms/bookify/.well-known/openid-configuration",
        "Authentication__RequireHttpsMetadata": "false"
      }
    }
  }
}