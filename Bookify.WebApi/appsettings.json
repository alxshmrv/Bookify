{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name" :  "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://bookify-seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5435;Database=bookify_db;User Id=postgres;Password=postgres;IncludeErrorDetail=true"
  },
  "AllowedHosts": "*"
}